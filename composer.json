{
    "name": "pdir/contao-matomo-ai-tracking",
    "description": "Serverseitiges Tracking von AI-Chatbots (ChatGPT-User, Claude-User, Perplexity-User, …) in Matomo für Contao 5 und 6",
    "license": "MIT",
    "type": "contao-bundle",
    "keywords": [
        "contao",
        "matomo",
        "ai",
        "bot",
        "tracking",
        "chatgpt",
        "claude",
        "perplexity"
    ],
    "authors": [
        {
            "name": "pdir GmbH",
            "homepage": "https://github.com/pdir",
            "role": "Developer"
        },
        {
            "name": "Mathias Arzberger",
            "homepage": "https://pdir.de/",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/pdir/contao-matomo-ai-tracking",
    "support": {
        "issues": "https://github.com/pdir/contao-matomo-ai-tracking/issues",
        "source": "https://github.com/pdir/contao-matomo-ai-tracking"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.7 || ^4.0",
        "friendsofsymfony/http-cache": "^2.16 || ^3.1",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.9",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.9 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Pdir\\MatomoAiTrackingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pdir\\MatomoAiTrackingBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    },
    "extra": {
        "contao-manager-plugin": "Pdir\\MatomoAiTrackingBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "update-user-agents": "php scripts/update-ai-user-agents.php"
    }
}
